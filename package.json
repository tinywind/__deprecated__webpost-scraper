{
  "name": "electron-react-tailwind-template",
  "author": {
    "email": "demirci.baris38@gmail.com",
    "name": "Barış DEMİRCİ",
    "url": "https://338.rocks"
  },
  "description": "Electron app template with React and Tailwind CSS",
  "repository": {
    "type": "git",
    "url": "https://github.com/barbarbar338/electron-react-tailwind-template"
  },
  "license": "GPL-3.0",
  "version": "1.0.1",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3",
    "tailwindcss": "3.4.3",
    "taze": "^21.3.0",
    "typescript": "~6.0.3",
    "wait-on": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "vite": "^8.3.5",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "auto-launch": "^5.0.6",
    "electron-is-dev": "^3.0.1",
    "electron-reloader": "^1.2.3",
    "electron-updater": "^6.1.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^10.0.5",
    "react-use": "^17.5.0"
  },
  "homepage": "./",
  "main": "public/electron.js",
  "scripts": {
    "dev": "concurrently \"npm run react:dev\" \"npm run electron:wait\"",
    "electron:wait": "wait-on tcp:3000 && npm run electron:dev",
    "prebuild": "rimraf build && rimraf dist",
    "react:build": "tsc --noEmit && npm run lint && vite build",
    "react:dev": "vite --port 3000 --strictPort",
    "electron:build": "electron-builder build --win --publish never",
    "electron:deploy": "electron-builder build --win --publish always",
    "electron:dev": "electron .",
    "build": "npm run react:build && npm run electron:build",
    "deploy": "npm run react:build && npm run electron:deploy",
    "format": "prettier --write . --ignore-path .gitignore",
    "update": "taze -w",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "eslint-config-react-app": {
      "@typescript-eslint/parser": "^8.72.1",
      "@typescript-eslint/eslint-plugin": "^8.72.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "files": [
      "build/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/amethyst.png",
        "to": "app-icon.png"
      }
    ]
  }
}
